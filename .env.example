# Vercel Postgres (Neon) — connection details
# Get these from Vercel Dashboard → Storage → your database → .env.local tab

# Recommended for most uses (pooled via pgbouncer)
DATABASE_URL=
# For uses requiring a direct connection (e.g., migrations)
DATABASE_URL_UNPOOLED=

# Individual connection parameters
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Vercel Postgres convenience aliases
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# AnythingLLM
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_BASE_URL=
ANYTHINGLLM_WORKSPACE_SLUG=
